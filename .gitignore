# Root .gitignore for Exchange Community (Frontend + Backend)

# Node
exchange-frontend/node_modules/
exchange-frontend/dist/
exchange-frontend/dist-ssr/
exchange-frontend/*.local
**/node_modules/
**/dist/

# PHP / Composer / Laravel
exchange-backend/vendor/
exchange-backend/.env
exchange-backend/.env.backup
exchange-backend/.env.production
exchange-backend/storage/*.key
exchange-backend/storage/pail/
exchange-backend/storage/framework/cache/data/*
exchange-backend/storage/framework/sessions/*
exchange-backend/storage/framework/views/*
exchange-backend/storage/logs/*
exchange-backend/public/storage
exchange-backend/public/hot
exchange-backend/public/build
**/vendor/

# Environment files
.env
*.env

# Logs and databases
*.log
logs/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
